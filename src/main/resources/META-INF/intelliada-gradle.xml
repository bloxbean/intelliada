<idea-plugin>
    <!-- JOUST M2 (ADR-004 D9): the new-project wizard links the Gradle build it created, only with IntelliJ's Gradle plugin -->
    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceInterface="com.bloxbean.intelliada.idea.joust.wizard.JoustBuildLinker"
                            serviceImplementation="com.bloxbean.intelliada.idea.joust.wizard.gradle.JoustGradleBuildLinker"/>
        <!-- JOUST M2 (ADR-004 D7, D8): Gradle tasks through IntelliJ's Gradle integration -->
        <applicationService serviceInterface="com.bloxbean.intelliada.idea.joust.tasks.JoustGradleTasks"
                            serviceImplementation="com.bloxbean.intelliada.idea.joust.tasks.gradle.JoustGradleTasksImpl"/>
        <externalSystemTaskNotificationListener implementation="com.bloxbean.intelliada.idea.joust.tasks.gradle.JoustAbiFailureListener"/>
        <!-- JOUST ADR-005 M3.1b (D15): the read-only run panel; its dev host is launched through Gradle (joustHostSpec) -->
        <toolWindow id="JOUST Run" anchor="bottom" canCloseContents="false"
                    factoryClass="com.bloxbean.intelliada.idea.joust.run.JoustRunToolWindowFactory"/>
    </extensions>
    <actions>
        <!-- ADR-004 D7: the JOUST actions in the Gradle tool window's project and module menus too -->
        <reference ref="com.bloxbean.intelliada.idea.joust.JoustProjectGroup">
            <add-to-group group-id="ExternalSystemView.ProjectMenu" anchor="last"/>
            <add-to-group group-id="ExternalSystemView.ModuleMenu" anchor="last"/>
        </reference>
    </actions>
</idea-plugin>
